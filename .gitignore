# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/

# 测试与类型检查
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# 证书与私钥（demo / demo-group 各智能体 acps-atr 目录）
**/acps-atr/private/*
!**/acps-atr/private/.gitkeep
**/acps-atr/certs/*
!**/acps-atr/certs/.gitkeep

# ACS 本地副本（保留 acs.json.example 模板）
**/acps-atr/acs.json

# ATR 注册临时文件（eab 在 acps-atr 根目录，非 private/）
**/acps-atr/eab.json

# 环境变量（保留 .env.example 模板）
.env
.env.local
.env.*.local

# acps-cli 本地密钥与登录 token（保留 acps-cli.toml 模板）
**/.acps-cli/
keyfiles/

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# 操作系统
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# 日志
*.log
logs/
