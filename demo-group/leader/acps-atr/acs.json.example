  "name": "群组模式 Leader",
  "description": "创建 RabbitMQ 群组、邀请 Partner 入群并广播任务。不对外提供 JSON-RPC 服务端点。",
  "version": "1.0.0",
  "provider": {
    "organization": "ACPs工作组",
